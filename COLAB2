}

def analyze_complaint(text):
    if not isinstance(text, str) or not text.strip():
        return {cat: False for cat in categories}
    doc = nlp(text.lower())
    text_lower = text.lower()
    results = {}
    for cat, keywords in categories.items():
        match = any(fuzz.partial_ratio(kw.lower(), text_lower) > 85 for kw in keywords)
        if not match:
            match = any(ent.text in text_lower for ent in doc.ents)
        results[cat] = match
    return results

print("Running full analysis on all rows...")

results_full = df.with_columns([
    pl.col("DESCRIPTION").map_elements(analyze_complaint, return_dtype=pl.Object).alias("tags")
])

print("✅ FULL ANALYSIS COMPLETE!")

summary = {}
for cat in categories.keys():
    count = results_full.select(pl.col("tags").map_elements(lambda x: x.get(cat, False), return_dtype=pl.Boolean).sum()).item()
    summary[cat] = count

print("\n=== SUMMARY COUNTS FOR DISTRICT 7 ===")
for cat, count in sorted(summary.items(), key=lambda x: x[1], reverse=True):
    print(f"{cat}: {count:,}")

results_full.write_csv("D7_Full_Smart_Analysis.csv")
