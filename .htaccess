Options -Indexes
DirectoryIndex index.html

<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Block .git
  RewriteRule ^\.git - [F,L]

  # Block private directories
  RewriteRule ^(SCRIPTS|DATA|ANALYSIS|CHANGES_AND_QUESTIONS|ARCHIVE|notebooks|output|grok_pulls|RANKINGS|DISTRICTS_COLAB|CORRECTED|VERIFIED_PIPELINE) - [F,L]

  # Block private file extensions at root level
  RewriteRule ^[^/]+\.(py|csv|xlsx|docx|ps1|jsonl|pkl|ipynb|sh|bat|sql|db)$ - [F,L]
</IfModule>
